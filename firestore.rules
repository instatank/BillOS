rules_version = '2';

// BillOS Firestore security rules — V1 (MVP Shell, sub-task 3)
//
// Data model:
//   /households/{hid}
//     members: [uid]                  // 1 or 2 entries
//     memberProfiles: { [uid]: {...} }
//     inviteCode: string | null
//     inviteCodeExpiresAt: timestamp | null
//   /households/{hid}/bills/{bid}     // ships in sub-task 4
//   /inviteCodes/{code}               // doc id IS the 6-digit code
//     householdId: string
//     createdBy: uid
//     expiresAt: timestamp
//
// Threat model for V1:
//  - Two trusted users per household. Hostile inputs are out of scope for MVP Shell.
//  - Anyone authed can read invite codes (needed to resolve a code → household).
//  - A non-member can update a household ONLY to add themselves via a valid invite.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(hh) {
      return isSignedIn() && (request.auth.uid in hh.members);
    }

    // --- households ---------------------------------------------------
    match /households/{hid} {

      // Members can always read. A non-member can read only while there is
      // an active invite code on the household — that's how the join flow
      // checks member count and capacity. Once a second member joins,
      // inviteCode is cleared and outsiders lose read access again.
      allow read: if isMember(resource.data)
                  || (isSignedIn() && resource.data.inviteCode != null);

      // Create: caller must be the sole initial member.
      allow create: if isSignedIn()
                    && request.resource.data.members is list
                    && request.resource.data.members.size() == 1
                    && request.resource.data.members[0] == request.auth.uid
                    && request.resource.data.createdBy == request.auth.uid;

      // Update: existing members can update freely.
      // Special case: a non-member can join via invite code, going from 1 → 2 members.
      allow update: if isMember(resource.data)
                    || (
                      isSignedIn()
                      && resource.data.members.size() == 1
                      && request.resource.data.members.size() == 2
                      && request.auth.uid in request.resource.data.members
                      && request.resource.data.members.hasAll(resource.data.members)
                      && request.resource.data.inviteCode == null
                    );

      allow delete: if false;

      // --- bills (sub-task 4 will write to this) -----------------------
      match /bills/{bid} {
        allow read, write: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
      }
    }

    // --- inviteCodes --------------------------------------------------
    match /inviteCodes/{code} {
      // Any signed-in user may read so they can resolve a shared code.
      allow read: if isSignedIn();

      // Create: caller must stamp themselves as creator. We don't check that
      // the linked household exists, because invite codes are written in the
      // same batch as a fresh household — `exists()` would see pre-batch
      // state and fail. A stray invite code with no household is harmless;
      // the join flow will reject it.
      allow create: if isSignedIn()
                    && request.resource.data.createdBy == request.auth.uid;

      // Update: not used by the app; deny.
      allow update: if false;

      // Delete: allowed by either an existing member of the linked household
      // (regenerate flow) or by the joining user during the join transaction.
      allow delete: if isSignedIn();
    }
  }
}
